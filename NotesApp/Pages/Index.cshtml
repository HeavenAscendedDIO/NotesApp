@page
@model IndexModel
@{
    ViewData["Title"] = "Заметки";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4 text-center">AJAX Заметки</h2>

    <div class="mb-3">
        <input type="search" id="noteSearch" class="form-control" placeholder="Поиск заметок..." />
    </div>

    <div id="noteContainer">
        <div class="text-center text-muted">Загрузка заметок</div>
    </div>

    <div id="noResults" class="text-center text-muted" style="display: none;">
        Ничего не найдено
    </div>
</div>

<button type="button"
        class="btn btn-primary rounded-circle shadow-lg position-fixed d-flex align-items-center justify-content-center"
        style="width: 56px; height: 56px; bottom: 30px; right: 30px; z-index: 1050; font-size: 28px; line-height: 1; padding: 0;"
        data-bs-toggle="modal"
        data-bs-target="#addNoteModal"
        title="Добавить заметку">
    +
</button>

<div class="modal fade" id="addNoteModal" tabindex="-1" aria-labelledby="addNoteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addNoteModalLabel">Новая заметка</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="noteTitle" class="form-control" placeholder="Заголовок" />
                </div>
                <div class="mb-3">
                    <textarea id="noteContent" class="form-control" rows="3" placeholder="Текст заметки"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" onclick="addNote()" class="btn btn-primary">Сохранить</button>
            </div>
        </div>
    </div>
</div>