@page
@model IndexModel
@{
    ViewData["Title"] = "Заметки";
}

<div class="app-page-header">
    <div>
        <h1 class="app-title h3 mb-1">Заметки</h1>
        <div class="app-subtitle">Личные записи с форматированием и поиском</div>
    </div>
    <div class="app-search w-100">
        <input type="search" id="noteSearch" class="form-control" placeholder="Поиск заметок..." />
    </div>
</div>

<div id="noteContainer" class="notes-grid">
    <div class="empty-state">
        <span class="empty-state-icon">⏳</span>
        <div>Загрузка заметок…</div>
    </div>
</div>

<div id="noResults" class="empty-state mt-3" style="display: none;">
    <span class="empty-state-icon">🔍</span>
    <div class="empty-state-title">Ничего не найдено</div>
    <div>Попробуйте изменить поисковый запрос.</div>
</div>

<button type="button"
        class="btn btn-primary rounded-circle shadow-lg position-fixed d-flex align-items-center justify-content-center"
        style="width: 56px; height: 56px; bottom: 30px; right: 30px; z-index: 1050; font-size: 28px; line-height: 1; padding: 0;"
        data-bs-toggle="modal"
        data-bs-target="#addNoteModal"
        title="Добавить заметку">
    +
</button>

<div class="modal fade app-modal" id="addNoteModal" tabindex="-1" aria-labelledby="addNoteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addNoteModalLabel">Новая заметка</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="noteTitle" class="form-label">Заголовок</label>
                    <input type="text" id="noteTitle" class="form-control" placeholder="Например, идеи для проекта" />
                </div>
                <div class="mb-1">
                    <label for="noteContent" class="form-label">Текст заметки</label>
                    <textarea id="noteContent" class="form-control" rows="4" placeholder="Пишите свободно…"></textarea>
                </div>
                <div class="form-text">Форматирование и цвет текста можно изменить прямо на карточке.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" onclick="addNote()" class="btn btn-primary">Сохранить</button>
            </div>
        </div>
    </div>
</div>
